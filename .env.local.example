# Supabase — get these from your project's API settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI — for embeddings (text-embedding-3-small, ~$0 cost for personal use)
OPENAI_API_KEY=your-openai-key

# OpenRouter — https://openrouter.ai/settings/keys (for the Adapt feature)
OPENROUTER_API_KEY=your-openrouter-key
# Any OpenRouter model ID, e.g. anthropic/claude-haiku-4-5, openai/gpt-4o-mini
OPENROUTER_MODEL=anthropic/claude-haiku-4-5
