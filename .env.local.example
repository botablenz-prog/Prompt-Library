# Supabase — get these from your project's API settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenRouter — https://openrouter.ai/settings/keys
# Used for: Adapt feature (LLM) + embeddings (text-embedding-3-small)
OPENROUTER_API_KEY=your-openrouter-key
# Any OpenRouter model ID, e.g. anthropic/claude-haiku-4-5, openai/gpt-4o-mini
OPENROUTER_MODEL=anthropic/claude-haiku-4-5

# Auth setup notes:
# 1. Run migration 004 in Supabase SQL Editor or via `supabase db push`
# 2. Create your admin account: Supabase Dashboard → Authentication → Users → Invite user
# 3. npm run set-admin -- <your-user-id>
# 4. Re-login to get a fresh JWT with the admin role
# 5. npm run backfill-owner -- <your-user-id>
# Login uses email OTP (6-digit code). No extra env vars needed —
# Supabase handles OTP email delivery via its built-in email service.
